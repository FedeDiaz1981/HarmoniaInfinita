    text: 'Mejora tu flexibilidad, libera tensiones y restaura tu bienestar físico y mental.',
    icon: Activity,
    tone: 'rose',
    imageSide: 'right',
    image: '/assets/therapy-details/weekly-stretching.jpg',
  },
];

const groupClasses = [
  {
    title: 'Meditación grupal',
    text: 'Encuentros de meditación para calmar la mente, expandir la conciencia y cultivar la paz interior juntos.',
    image: '/assets/therapy-thumbs/meditacion-grupal.jpg',
  },
  {
    title: 'Rito de Útero',
    text: 'Un espacio sagrado para honrar tu esencia femenina, sanar tu linaje y reconectar con tu poder creador.',
    image: '/assets/therapy-thumbs/rito-utero.jpg',
  },
  {
    title: 'Constelaciones familiares',
    text: 'Trabajo terapéutico para comprender, sanar y transformar dinámicas familiares, patrones y vínculos.',
    image: '/assets/therapy-thumbs/constelaciones.jpg',
  },
];

const groupDetails = [
  {
    title: 'Meditación grupal',
    text: 'Encuentros de meditación para calmar la mente, expandir la conciencia y cultivar la paz interior juntos.',
    icon: UsersRound,
    tone: 'rose',
    imageSide: 'left',
    image: '/assets/therapy-details/group-meditacion.jpg',
  },
  {
    title: 'Rito de Útero',
    text: 'Un espacio sagrado para honrar tu esencia femenina, sanar tu linaje y reconectar con tu poder creador.',
    icon: Flower2,
    tone: 'rose',
    imageSide: 'right',
    image: '/assets/therapy-details/group-rito-utero.jpg',
  },
  {
    title: 'Trabajo sistémico grupal',
    text: 'Para comprender, sanar y transformar dinámicas familiares, patrones y vínculos. Vincular - Sistémico.',
    icon: HeartHandshake,
    tone: 'rose',
    imageSide: 'left',
    image: '/assets/therapy-details/group-trabajo-sistemico.jpg',
  },
];

const toneClasses = {
  green: 'bg-[#586b48] text-[#fffaf3]',
  rose: 'bg-[#b56f6d] text-[#fffaf3]',
};
---

<section id="terapias" class="relative overflow-hidden bg-[#fff7ef] py-10 text-[#1f1b16] sm:py-14 lg:pt-16">
  <div class="pointer-events-none absolute left-0 top-0 hidden sm:block" aria-hidden="true">
    <img src="/assets/mockups/hoja_Sup_Izq.png" alt="" class="h-auto w-[250px] opacity-65 md:w-[300px] lg:w-[360px] xl:w-[450px]" />
  </div>
  <div class="pointer-events-none absolute right-0 top-0 hidden sm:block" aria-hidden="true">
    <img src="/assets/mockups/hoja_Sup_Der.png" alt="" class="h-auto w-[250px] opacity-65 md:w-[300px] lg:w-[360px] xl:w-[450px]" />
  </div>

  <div class="section-shell relative">
    <div class="mx-auto text-center">
      <Flower2 class="mx-auto mb-2 text-[#b56f6d]" size={28} strokeWidth={1.4} />
      <h2 class="mx-auto max-w-[21ch] font-display text-[2.35rem] font-bold uppercase leading-[0.95] text-[#241e18] sm:text-[3.1rem] md:text-[3.5rem] lg:text-[4rem]">
        Elige tu camino de bienestar
      </h2>
      <p class="mx-auto mt-3 max-w-[34ch] font-display text-[1.45rem] font-semibold text-[#9f5f5d] sm:text-2xl lg:text-3xl">
        Un espacio para sanar, conectar y transformar tu bienestar integral
      </p>
      <div class="mt-3 flex items-center justify-center gap-3 text-[#7a644f] sm:gap-5">
        <span class="h-px w-14 bg-[#b56f6d]/35"></span>
        <p class="font-display text-base font-semibold sm:text-lg lg:text-xl">Trabajo profundo, personalizado y uno a uno</p>
        <span class="h-px w-14 bg-[#b56f6d]/35"></span>
      </div>
    </div>

    <div class="mt-7 space-y-4">
      {topGroups
        .filter((group) => group.panel === 'individuals')
        .map((group) => (
          <article
            class="group rounded-[16px] border border-[#d8c9bd] bg-[#fffaf3]/80 p-3 shadow-sm transition data-[state=open]:ring-2 data-[state=open]:ring-[#b56f6d]/45 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#b56f6d]/45"
            data-therapy-trigger={group.panel}
            data-state={group.panel ? 'closed' : undefined}
            role="button"
            tabindex="0"
            aria-controls={group.panelId}
            aria-expanded={group.panel ? 'false' : undefined}
          >
            <div class={`mx-auto mb-3 flex w-fit items-center gap-2 rounded-full px-5 py-1.5 shadow-sm ${toneClasses.green}`}>
              <Flower2 size={20} strokeWidth={1.5} />
              <h3 class="font-display text-xl font-bold uppercase leading-none">{group.title}</h3>
              <ChevronDown class="transition group-data-[state=open]:rotate-180" size={18} strokeWidth={2} />
            </div>
            <div class={`hidden gap-x-0 gap-y-4 divide-[#d8c9bd] ${group.columns} sm:divide-x md:grid`}>
              {group.items.map((item) => (
                <div class="flex h-full min-w-0 flex-col items-center px-2 py-1.5 text-center">
                  <div
                    class="mx-auto mb-3 h-20 w-20 shrink-0 rounded-full border border-white/70 bg-cover shadow-sm sm:h-24 sm:w-24"
                    aria-hidden="true"
                  >
                    <img src={item.image} alt="" class="h-full w-full rounded-full object-cover" loading="lazy" decoding="async" />
                  </div>
                  <h4 class="min-h-[4.8em] w-full px-1 font-display text-[12px] leading-[1.08] font-bold text-[#231e18] sm:text-[13px] lg:text-[14px]">
                    {item.title}
                  </h4>
                  <p class="mt-2 w-full px-1 text-[10px] leading-[1.28] text-[#4f463d] sm:text-[11px] sm:leading-[1.35]">{item.text}</p>
                </div>
              ))}
            </div>
          </article>
        ))}

      <section id="sesiones-individuales-detalle" data-therapy-panel="individuals" class="hidden scroll-mt-28" hidden>
        <div class="mx-auto grid max-w-5xl gap-2">
          {individualDetails.map((item) => {
            const Icon = item.icon;
            return (
              <article class="grid overflow-hidden rounded-none border border-[#e0d3c8] bg-[#fffaf3]/92 shadow-sm md:rounded-[12px] md:grid-cols-2">
                {item.imageSide === 'left' && (
                  <div class="relative hidden overflow-hidden md:block md:min-h-36" aria-hidden="true">
                    <img src={item.image} alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
                  </div>
                )}
                <div class="flex items-center gap-5 p-4 sm:p-5">
                  <div class="grid h-20 w-20 shrink-0 place-items-center overflow-hidden rounded-full border border-white/80 bg-[#f4eadf] shadow-sm md:hidden">
                    <img src={item.image} alt="" class="h-full w-full object-cover object-center" loading="lazy" decoding="async" />
                  </div>
                  <div class={`hidden h-20 w-20 shrink-0 place-items-center rounded-full shadow-sm md:grid ${toneClasses[item.tone]}`}>
                    <Icon size={38} strokeWidth={1.35} />
                  </div>
                  <div>
                    <h4 class="font-display text-2xl font-bold uppercase leading-none text-[#586b48]">{item.title}</h4>
                    <div class="my-2 flex items-center gap-2 text-[#b56f6d]">
                      <span class="h-px w-16 bg-[#b56f6d]/35"></span>
                      <Flower2 size={15} strokeWidth={1.4} />
                    </div>
                  <p class="max-w-md text-sm font-medium leading-6 text-[#3f372f]">{item.text}</p>
                </div>
              </div>
              {item.imageSide !== 'left' && (
                  <div class="relative hidden overflow-hidden md:block md:min-h-36" aria-hidden="true">
                    <img src={item.image} alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
                  </div>
              )}
            </article>
            );
          })}
        </div>
      </section>

      <div class="grid gap-4 lg:grid-cols-2">
        {topGroups
          .filter((group) => group.panel !== 'individuals')
          .map((group) => (
            <article
              class="group rounded-[16px] border border-[#d8c9bd] bg-[#fffaf3]/80 p-3 shadow-sm transition data-[state=open]:ring-2 data-[state=open]:ring-[#b56f6d]/45 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#b56f6d]/45"
              data-therapy-trigger={group.panel}
              data-state={group.panel ? 'closed' : undefined}
              role="button"
              tabindex="0"
              aria-controls={group.panelId}
              aria-expanded={group.panel ? 'false' : undefined}
            >
              <div class={`mx-auto mb-3 flex w-fit items-center gap-2 rounded-full px-5 py-1.5 shadow-sm ${toneClasses.green}`}>
                <Flower2 size={20} strokeWidth={1.5} />
                <h3 class="font-display text-xl font-bold uppercase leading-none">{group.title}</h3>
                <ChevronDown class="transition group-data-[state=open]:rotate-180" size={18} strokeWidth={2} />
              </div>
              <div class={`hidden gap-x-0 gap-y-4 divide-[#d8c9bd] ${group.columns} sm:divide-x md:grid`}>
                {group.items.map((item) => (
                  <div class="flex h-full min-w-0 flex-col items-center px-2 py-1.5 text-center">
                    <div
                      class="mx-auto mb-3 h-20 w-20 shrink-0 rounded-full border border-white/70 bg-cover shadow-sm sm:h-24 sm:w-24"
                      aria-hidden="true"
                    >
                      <img src={item.image} alt="" class="h-full w-full rounded-full object-cover" loading="lazy" decoding="async" />
                    </div>
                    <h4 class="min-h-[4.8em] w-full px-1 font-display text-[12px] leading-[1.08] font-bold text-[#231e18] sm:text-[13px] lg:text-[14px]">
                      {item.title}
                    </h4>
                    <p class="mt-2 w-full px-1 text-[10px] leading-[1.28] text-[#4f463d] sm:text-[11px] sm:leading-[1.35]">{item.text}</p>
                  </div>
                ))}
              </div>
            </article>
          ))}
      </div>
    </div>

    <section id="corporal-emocional-detalle" data-therapy-panel="bodyEmotion" class="mt-5 hidden scroll-mt-28" hidden>
      <div class="mx-auto grid max-w-5xl gap-2">
        {bodyEmotionDetails.map((item) => {
          const Icon = item.icon;
          return (
            <article class="grid overflow-hidden rounded-none border border-[#e0d3c8] bg-[#fffaf3]/92 shadow-sm md:rounded-[12px] md:grid-cols-2">
              {item.imageSide === 'left' && (
                <div class="relative hidden overflow-hidden md:block md:min-h-36" aria-hidden="true">
                  <img src={item.image} alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
                </div>
              )}
              <div class="flex items-center gap-5 p-4 sm:p-5">
                <div class="grid h-20 w-20 shrink-0 place-items-center overflow-hidden rounded-full border border-white/80 bg-[#f4eadf] shadow-sm md:hidden">
                  <img src={item.image} alt="" class="h-full w-full object-cover object-center" loading="lazy" decoding="async" />
                </div>
                <div class={`hidden h-20 w-20 shrink-0 place-items-center rounded-full shadow-sm md:grid ${toneClasses[item.tone]}`}>
                  <Icon size={38} strokeWidth={1.35} />
                </div>
                <div>
                  <h4 class="font-display text-2xl font-bold uppercase leading-none text-[#586b48]">{item.title}</h4>
                  <div class="my-2 flex items-center gap-2 text-[#b56f6d]">
                    <span class="h-px w-16 bg-[#b56f6d]/35"></span>
                    <Flower2 size={15} strokeWidth={1.4} />
                  </div>
                  <p class="max-w-md text-sm font-medium leading-6 text-[#3f372f]">{item.text}</p>
                </div>
              </div>
              {item.imageSide !== 'left' && (
                <div class="relative hidden overflow-hidden md:block md:min-h-36" aria-hidden="true">
                  <img src={item.image} alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
                </div>
              )}
            </article>
          );
        })}
      </div>
    </section>

    <section id="conciencia-direccion-detalle" data-therapy-panel="direction" class="mt-5 hidden scroll-mt-28" hidden>
      <div class="mx-auto grid max-w-5xl gap-2">
        {directionDetails.map((item) => {
          const Icon = item.icon;
          return (
            <article class="grid overflow-hidden rounded-none border border-[#e0d3c8] bg-[#fffaf3]/92 shadow-sm md:rounded-[12px] md:grid-cols-2">
              {item.imageSide === 'left' && (
                <div class="relative hidden overflow-hidden md:block md:min-h-36" aria-hidden="true">
                  <img src={item.image} alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
                </div>
              )}
              <div class="flex items-center gap-5 p-4 sm:p-5">
                <div class="grid h-20 w-20 shrink-0 place-items-center overflow-hidden rounded-full border border-white/80 bg-[#f4eadf] shadow-sm md:hidden">
                  <img src={item.image} alt="" class="h-full w-full object-cover object-center" loading="lazy" decoding="async" />
                </div>
                <div class={`hidden h-20 w-20 shrink-0 place-items-center rounded-full shadow-sm md:grid ${toneClasses[item.tone]}`}>
                  <Icon size={38} strokeWidth={1.35} />
                </div>
                <div>
                  <h4 class="font-display text-2xl font-bold uppercase leading-none text-[#586b48]">{item.title}</h4>
                  <div class="my-2 flex items-center gap-2 text-[#b56f6d]">
                    <span class="h-px w-16 bg-[#b56f6d]/35"></span>
                    <Flower2 size={15} strokeWidth={1.4} />
                  </div>
                  <p class="max-w-md text-sm font-medium leading-6 text-[#3f372f]">{item.text}</p>
                </div>
              </div>
              {item.imageSide !== 'left' && (
                <div class="relative hidden overflow-hidden md:block md:min-h-36" aria-hidden="true">
                  <img src={item.image} alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
                </div>
              )}
            </article>
          );
        })}
      </div>
    </section>

    <div class="mt-5 grid gap-3 lg:grid-cols-2">
      <article
        class="group cursor-pointer overflow-hidden rounded-[16px] border border-[#d8c9bd] bg-[#fffaf3]/82 shadow-sm transition data-[state=open]:ring-2 data-[state=open]:ring-[#b56f6d]/45 focus:outline-none focus:ring-2 focus:ring-[#b56f6d]/45"
        data-therapy-trigger="weekly"
        data-state="closed"
        role="button"
        tabindex="0"
        aria-controls="clases-semanales-detalle"
        aria-expanded="false"
