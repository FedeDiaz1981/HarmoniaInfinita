    text: 'Fortalece y alinea tu cuerpo desde el centro con movimientos conscientes y fluidos.',
    icon: Dumbbell,
    tone: 'green',
    imageSide: 'left',
    image: '/assets/therapy-details/weekly-pilates.jpg',
  },
  {
