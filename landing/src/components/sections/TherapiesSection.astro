<script>
  const therapyTriggers = document.querySelectorAll('[data-therapy-trigger]');
  const therapyPanels = document.querySelectorAll('[data-therapy-panel]');
  const mobileQuery = window.matchMedia('(max-width: 767px)');

  const originalPanelPositions = new Map();
  therapyPanels.forEach((panel) => {
    if (!(panel instanceof HTMLElement)) return;
    originalPanelPositions.set(panel.dataset.therapyPanel, {
      panel,
      parent: panel.parentNode,
      nextSibling: panel.nextSibling,
    });
  });

  const restoreDesktopPanelLayout = () => {
    originalPanelPositions.forEach((entry) => {
      if (!entry || !(entry.panel instanceof HTMLElement) || !entry.parent) return;
      if (entry.nextSibling) {
        entry.parent.insertBefore(entry.panel, entry.nextSibling);
      } else {
        entry.parent.appendChild(entry.panel);
      }
    });
  };

  const setTherapyPanel = (panelName, open) => {
    let activePanel = null;
    const isMobile = mobileQuery.matches;

    therapyPanels.forEach((panel) => {
      if (!(panel instanceof HTMLElement)) return;
      const isTarget = panel.dataset.therapyPanel === panelName;
      const shouldOpen = isTarget && open;
      panel.hidden = !shouldOpen;
      panel.classList.toggle('hidden', !shouldOpen);
      if (shouldOpen) activePanel = panel;
    });

    therapyTriggers.forEach((trigger) => {
      if (!(trigger instanceof HTMLElement)) return;
      const shouldOpen = trigger.dataset.therapyTrigger === panelName && open;
      trigger.dataset.state = shouldOpen ? 'open' : 'closed';
      trigger.setAttribute('aria-expanded', String(shouldOpen));
    });

    if (activePanel) {
      if (isMobile) {
        const activeTrigger = Array.from(therapyTriggers).find(
          (trigger) =>
            trigger instanceof HTMLElement &&
            trigger.dataset.therapyTrigger === panelName
        );
        if (activeTrigger instanceof HTMLElement) {
          activeTrigger.insertAdjacentElement('afterend', activePanel);
        }
      } else {
        restoreDesktopPanelLayout();
      }

      window.requestAnimationFrame(() => {
        activePanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    } else if (!isMobile) {
      restoreDesktopPanelLayout();
    }
  };

  therapyTriggers.forEach((trigger) => {
    const toggle = () => {
      if (!(trigger instanceof HTMLElement)) return;
      const panelName = trigger.dataset.therapyTrigger;
      if (!panelName) return;
      const isOpen = trigger.dataset.state === 'open';
      setTherapyPanel(panelName, !isOpen);
    };

    trigger.addEventListener('click', toggle);

    trigger.addEventListener('keydown', (event) => {
      if (!(event instanceof KeyboardEvent)) return;
      if (event.key !== 'Enter' && event.key !== ' ') return;

      event.preventDefault();
      toggle();
    });
  });

  mobileQuery.addEventListener('change', () => {
    if (!mobileQuery.matches) {
      restoreDesktopPanelLayout();
    }
  });
</script>
