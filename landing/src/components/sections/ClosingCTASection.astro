---
import { Heart, MessageCircle } from '@lucide/astro';
---

<section class="bg-[#f4ded8] px-4 py-14 text-center">
  <div class="mx-auto max-w-3xl">
    <h2 class="font-display text-4xl font-semibold leading-tight text-[#203b30]">
      Tu bienestar es tu mejor inversión
    </h2>
    <p class="mt-3 text-base text-[#5d524a]">Estamos para acompañarte.</p>
    <div class="mx-auto my-5 grid h-9 w-9 place-items-center rounded-full bg-[#b56f6d]/18 text-[#b56f6d]">
      <Heart size={19} strokeWidth={1.7} />
    </div>
    <a
      href="https://wa.me/5491154778543"
      class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[#40573c] px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-[#203b30] focus:outline-none focus:ring-2 focus:ring-[#40573c]/35"
    >
      <MessageCircle size={19} strokeWidth={1.8} />
      Reservar una sesión
    </a>
  </div>
</section>
